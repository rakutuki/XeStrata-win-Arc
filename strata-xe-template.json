{
  "exe": "%TREE%\\build-rel\\strata.exe",
  "args": [
    "--pack",
    "%DATA%\\packs\\iq3_s43",
    "--native",
    "%DATA%\\models\\IQ3_S\\Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf",
    "--ple-gguf",
    "%DATA%\\models\\IQ3_S\\Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00002-of-00002.gguf",
    "--expert-cache",
    "auto",
    "--pcie-frac",
    "0.00",
    "--prefill",
    "auto",
    "--spec",
    "4",
    "--mtp",
    "%DATA%\\mtp\\rt",
    "--max-context",
    "262144",
    "--kv",
    "int8",
    "--spec-min-p",
    "0.70",
    "--conversation-cache-mib",
    "3072",
    "--conversation-cache-min-free-mib",
    "512",
    "--prompt-cache-tail"
  ],
  "cwd": "%TREE%",
  "tokenizer": "%DATA%\\packs\\iq3_s43\\tokenizer",
  "model_name": "xe-strata-iq3-s",
  "log": "%TREE%\\xe_serve_engine.log",
  "env": {
    "ZES_ENABLE_SYSMAN": "1",
    "STRATA_SKIP_DEVICE_TUNE": "1",
    "STRATA_ARENA_NO_REGISTER": "1",
    "STRATA_ARENA_LOW_RAM": "keep"
  },
  "port": 8080,
  "host": "0.0.0.0",
  "conversation_save": "%TREE%\\data\\conv-sessions",
  "conversation_save_compress": true,
  "reasoning_budget_tokens": 4096,
  "prevent_sleep": true,
  "expert_profile_save": "%TREE%\\data\\expert-profile-learned.bin",
  "keepwarm": true
}
